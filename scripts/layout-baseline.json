			"predicates": [
				"const files = globSync(pattern, { cwd: tree });",
				"tests: tests.filter((p) => !p.endsWith(\".cases.ts\"))",
				"\"baseline_tests\", baseline, testArgv(manifest.tests, false, GATE_TEST_CONCURRENCY),",
				"manifest.tests.filter((p) => existsSync(join(tree, p)))",
				"\"main_tests\", tree, testArgv(mainTests, false, GATE_TEST_CONCURRENCY),",
				"path.startsWith(\"test/\") && (!base.has(path) || path.startsWith(\"test/acceptance/\"));",
				"additional && /\\.(?:test|cases)\\.[cm]?[jt]s$/.test(path) && !path.startsWith(\"test/acceptance/\") ) newTests.push(path);",
				"\"candidate_tests\", tree, testArgv(material.newTests),"
			]
		}
