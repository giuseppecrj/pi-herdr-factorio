# Verification VMs. vm.sh and lane-setup.sh select one with FACTORY_VM
# (default pi-factorio). One line per target, whitespace separated:
#   <name> <ssh destination> <GH_HOST on that VM>
# A target with an empty value is not configured, and the scripts refuse it.
pi-factorio exedev@pi-factorio.exe.xyz github.int.exe.xyz
nubl-factory exedev@nubl-factory.exe.xyz github.int.exe.xyz
factorio
