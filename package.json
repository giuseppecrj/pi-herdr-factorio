{
  "name": "pi-herdr-factorio",
  "version": "0.1.0",
  "description": "Ticket-triggered software factory for Pi: a pure controller that drives specify, accept, build, validate, review and land",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "factory"
  ],
  "license": "MIT",
  "author": {
    "name": "Giuseppe Rodriguez",
    "url": "https://github.com/giuseppecrj"
  },
  "type": "module",
  "files": [
    "package.json",
    "extension/",
    "src/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:layout && npm run check:decisions && npm test && npm run test:integration",
    "check:decisions": "node scripts/check-decisions.mjs",
    "check:layout": "node --experimental-strip-types scripts/check-layout.mjs",
    "format": "biome format --write src extension host test .pi/skills docs/statecharts",
    "format:check": "biome format src extension host test .pi/skills docs/statecharts",
    "lint": "oxlint src extension host test .pi/skills docs/statecharts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"test/src/**/*.test.ts\" \"test/host/**/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-herdr-pstack": ">=0.4.0"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^26.6.6",
    "oxlint": "1.90.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nublai/pi-herdr-factorio.git"
  },
  "homepage": "https://github.com/nublai/pi-herdr-factorio#readme",
  "bugs": {
    "url": "https://github.com/nublai/pi-herdr-factorio/issues"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "undici": "8.12.3"
  }
}
