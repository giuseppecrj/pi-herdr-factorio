[Unit]
Description=pi-herdr-factorio controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/pi-herdr-factorio
Environment=GH_HOST=github.int.exe.xyz
Environment=PATH=/home/exedev/.local/bin:/home/exedev/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/exedev/.local/share/mise/shims/node server/cli.ts serve --repo giuseppecrj/pi-herdr-factorio --state-dir /home/exedev/factory-state
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=300
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
