{
  "meta": {
    "name": "Shep Design System",
    "version": "0.1.0",
    "status": "Approved by the owner 2026-11-05 (DECISIONS R18). Not wired into App/ until PR 1.",
    "appearance": "dark",
    "tiers": "palette (primitive) -> color (semantic) -> component. Components reference semantic tokens only; semantic tokens reference palette tokens only."
  },

  "palette": {
    "ink":     { "value": "#100F17", "origin": "brand palette", "note": "Near-black with a violet cast." },
    "night":   { "value": "#1A1823", "origin": "derived", "note": "Midpoint of Ink and Surface. Containers on the page." },
    "surface": { "value": "#25212F", "origin": "brand palette", "note": "Faintly purple-tinted surface." },
    "ridge":   { "value": "#2C2838", "origin": "derived", "note": "Surface lifted one step. Hairlines and card borders." },
    "haze":    { "value": "#6E6B80", "origin": "kept from TextTertiary (dark)", "note": "Disabled text, decorative glyphs, the offline dot." },
    "fog":     { "value": "#A8A5B8", "origin": "kept from TextSecondary (dark)", "note": "Secondary text." },
    "chalk":   { "value": "#DAD7E6", "origin": "kept from TerminalText", "note": "Default terminal text, dimmer than Cloud to cut glare in dense mono." },
    "cloud":   { "value": "#F4F0FA", "origin": "brand palette", "note": "Primary text and highlights." },
    "shep":    { "value": "#B898ED", "origin": "brand palette", "note": "The accent, for fills and glyphs." },
    "lilac":   { "value": "#D9C6FA", "origin": "brand palette", "note": "The accent, for text." },
    "amber":   { "value": "#FF9F0A", "origin": "kept from Blocked (dark)", "note": "Needs you: fills and glyphs." },
    "honey":   { "value": "#FFB340", "origin": "kept from BlockedText (dark)", "note": "Needs you: text." },
    "ember":   { "value": "#FF6961", "origin": "kept from ErrorText (dark)", "note": "The one red." },
    "meadow":  { "value": "#8DC9A0", "origin": "v2 prototype", "note": "Muted green, the Connected dot only." }
  },

  "color": {
    "background":       { "ref": "ink",     "asset": "Background",       "use": "Every screen, the composer area, the Terminal card." },
    "surface":          { "ref": "night",   "asset": "Surface",          "use": "Containers on the page: sheets, the filter card, grouped form backgrounds, conversation cards." },
    "surfaceRaised":    { "ref": "surface", "asset": "SurfaceRaised",    "use": "Things inside or on a container: tiles, fields, chips, user bubbles, the composer, form rows, keys." },
    "surfaceSelected":  { "ref": "shep", "alpha": 0.16, "over": "surface", "asset": null, "use": "The selected row's fill in the filter card and other single-choice lists. Drawn as Accent at 16 %." },

    "textPrimary":      { "ref": "cloud",   "asset": "TextPrimary",      "use": "Primary text: titles, messages, values." },
    "textSecondary":    { "ref": "fog",     "asset": "TextSecondary",    "use": "Secondary text: previews, times, captions, status words, placeholders." },
    "textTertiary":     { "ref": "haze",    "asset": "TextTertiary",     "use": "Disabled text and decorative glyphs only. Never a word that carries meaning, not even a placeholder." },
    "textAccent":       { "ref": "lilac",   "asset": "TextAccent",       "use": "Accent-coloured text: links, plain buttons, Add machine." },
    "textOnFill":       { "ref": "ink",     "asset": "TextOnFill",           "use": "Glyphs and text on an Accent or Attention fill." },

    "accent":           { "ref": "shep",    "asset": "AccentColor",      "use": "Fills and glyphs of primary actions, active controls and selected items. Also the global tint." },

    "borderSubtle":     { "ref": "ridge",   "asset": "BorderSubtle",     "use": "0.5 pt separators and 1 pt card borders." },

    "attention":        { "ref": "amber",   "asset": "Attention",        "use": "Needs you: the badge fill, the card bar, the needs-you glyph." },
    "attentionText":    { "ref": "honey",   "asset": "AttentionText",    "use": "Needs you: tinted text (time, 'Needs approval', 'pi asks', the count)." },
    "attentionTint":    { "ref": "amber", "alpha": 0.10, "over": "background", "asset": null, "use": "The approval and dialog card fill." },

    "error":            { "ref": "ember",   "asset": "Error",            "use": "Error text and glyphs. The only red Shep draws." },
    "errorTint":        { "ref": "ember", "alpha": 0.14, "over": "background", "asset": null, "use": "The offline banner fill." },

    "connected":        { "ref": "meadow",  "asset": "Connected",        "use": "The Connected dot. Nothing else." },
    "unread":           { "ref": "cloud",   "asset": null,               "use": "The unread dot on a finished chat (alias of TextPrimary)." },
    "neutralDot":       { "ref": "haze",    "asset": null,               "use": "The offline and connecting dot (alias of TextTertiary)." },

    "overlayFaint":     { "ref": "cloud", "alpha": 0.08, "over": "background", "asset": null, "use": "Low fills on glass or on the Terminal: pills, unlit keys in the pi screen sheet." },
    "overlayFill":      { "ref": "cloud", "alpha": 0.12, "over": "background", "asset": null, "use": "D-pad and glass key faces." },
    "overlayPressed":   { "ref": "cloud", "alpha": 0.28, "over": "background", "asset": null, "use": "Pressed glass key faces." }
  },

  "component": {
    "terminal": {
      "background": { "ref": "color.background" },
      "border":     { "ref": "color.borderSubtle" },
      "text":       { "palette": "chalk", "asset": "TerminalText" },
      "textDim":    { "palette": "chalk", "alpha": 0.6 },
      "cursor":     { "ref": "color.accent" },
      "divider":    { "ref": "color.borderSubtle" },
      "ansi": {
        "note": "Catppuccin Mocha, as D0a. Content colours drawn by the program, exempt from the one-meaning rule.",
        "values": ["#45475A", "#F38BA8", "#A6E3A1", "#F9E2AF", "#89B4FA", "#F5C2E7", "#94E2D5", "#BAC2DE",
                   "#585B70", "#F38BA8", "#A6E3A1", "#F9E2AF", "#89B4FA", "#F5C2E7", "#94E2D5", "#A6ADC8"]
      }
    },
    "chatRow": {
      "tile": { "fill": "color.surfaceRaised", "glyph": "color.textSecondary", "size": 48, "radius": "radius.key" },
      "title": "color.textPrimary",
      "preview": "color.textSecondary",
      "time": "color.textSecondary",
      "timeAttention": "color.attentionText",
      "timeUnread": "color.textPrimary",
      "badgeFill": "color.attention",
      "badgeGlyph": "color.textOnFill",
      "unreadDot": "color.unread",
      "machineLabel": "color.textSecondary"
    },
    "filterCard": {
      "fill": "color.surface",
      "border": "color.borderSubtle",
      "selectedFill": "color.surfaceSelected",
      "selectedGlyph": "color.accent",
      "rowGlyph": "color.textSecondary",
      "radius": "radius.large",
      "selectedRadius": "radius.card"
    },
    "composer": { "fill": "color.surfaceRaised", "radius": "radius.large", "placeholder": "color.textSecondary", "send": "color.accent", "sendGlyph": "color.textOnFill", "sendDisabledGlyph": "color.textTertiary" },
    "userBubble": { "fill": "color.surfaceRaised", "text": "color.textPrimary", "radius": "radius.large" },
    "card": { "fill": "color.surface", "border": "color.borderSubtle", "radius": "radius.card" },
    "attentionCard": { "fill": "color.attentionTint", "bar": "color.attention", "barWidth": 3, "header": "color.attentionText", "radius": "radius.card" },
    "banner": { "neutralFill": "color.surfaceRaised", "offlineFill": "color.errorTint", "offlineGlyph": "color.error" },
    "notice": { "fill": "color.surfaceRaised", "radius": "radius.key" },
    "machineTile": { "fill": "color.surfaceRaised", "glyph": "color.textSecondary", "size": 44, "radius": "radius.key" },
    "addTile": { "fill": "color.surfaceSelected", "glyph": "color.accent", "label": "color.textAccent" }
  },

  "space": {
    "unit": 4,
    "xxs": 2,
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 20,
    "xxl": 24,
    "xxxl": 32,
    "huge": 48,
    "page": 16,
    "edge": 8,
    "hitTarget": 44
  },

  "radius": {
    "chip": 8,
    "key": 12,
    "card": 16,
    "large": 24,
    "capsule": "capsule"
  },

  "opacity": {
    "stale": 0.6,
    "disabled": 0.4,
    "closed": 0.3
  },

  "type": {
    "largeTitle":   { "style": "largeTitle",  "weight": "bold",     "size": 34, "leading": 41 },
    "title":        { "style": "title3",      "weight": "semibold", "size": 20, "leading": 25 },
    "headline":     { "style": "headline",    "weight": "semibold", "size": 17, "leading": 22 },
    "body":         { "style": "body",        "weight": "regular",  "size": 17, "leading": 22 },
    "bodyStrong":   { "style": "body",        "weight": "semibold", "size": 17, "leading": 22 },
    "subheadline":  { "style": "subheadline", "weight": "regular",  "size": 15, "leading": 20 },
    "label":        { "style": "subheadline", "weight": "medium",   "size": 15, "leading": 20 },
    "footnote":     { "style": "footnote",    "weight": "regular",  "size": 13, "leading": 18 },
    "footnoteStrong": { "style": "footnote",  "weight": "medium",   "size": 13, "leading": 18 },
    "caption":      { "style": "caption",     "weight": "regular",  "size": 12, "leading": 16 },
    "badge":        { "style": "caption2",    "weight": "bold",     "size": 11, "leading": 13 },
    "monoCode":     { "style": "footnote",    "weight": "regular",  "size": 13, "leading": 18, "design": "monospaced" },
    "monoTerminal": { "style": "fixed",       "weight": "regular",  "size": 15, "leading": 20, "design": "monospaced", "note": "User-adjustable reading size (Settings), default 15 pt." }
  },

  "motion": {
    "press":    { "duration": 0.1,  "curve": "easeOut",  "use": "Press feedback on custom controls." },
    "quick":    { "duration": 0.2,  "curve": "easeOut",  "use": "A badge, dot or line appears or leaves." },
    "standard": { "duration": 0.25, "curve": "snappy",   "use": "Expand and collapse, banners, notices, trays." },
    "list":     { "duration": 0.3,  "curve": "snappy",   "use": "Rows moving between sections." },
    "menu":     { "duration": 0.35, "curve": "spring", "bounce": 0.15, "use": "The + menu growing from its button." },
    "appearDelay": { "duration": 1.5, "use": "How long the app waits before showing a connecting or offline banner." }
  },

  "contrast": {
    "minimums": { "text": 4.5, "large": 3.0, "nonText": 3.0 },
    "pairs": [
      { "fg": "textPrimary",   "bg": ["background", "surface", "surfaceRaised", "surfaceSelected", "attentionTint", "errorTint"], "kind": "text" },
      { "fg": "textSecondary", "bg": ["background", "surface", "surfaceRaised", "surfaceSelected", "attentionTint", "errorTint"], "kind": "text" },
      { "fg": "textTertiary",  "bg": ["background", "surface", "surfaceRaised"], "kind": "nonText" },
      { "fg": "textAccent",    "bg": ["background", "surface", "surfaceRaised", "surfaceSelected", "attentionTint", "errorTint"], "kind": "text" },
      { "fg": "accent",        "bg": ["background", "surface", "surfaceRaised", "surfaceSelected"], "kind": "nonText" },
      { "fg": "textOnFill",    "bg": ["accent", "attention"], "kind": "text" },
      { "fg": "attention",     "bg": ["background", "surface", "surfaceRaised"], "kind": "nonText" },
      { "fg": "attentionText", "bg": ["background", "surface", "attentionTint"], "kind": "text" },
      { "fg": "error",         "bg": ["background", "surface", "surfaceRaised", "errorTint"], "kind": "text" },
      { "fg": "connected",     "bg": ["background", "surface", "surfaceRaised"], "kind": "nonText" },
      { "fg": "unread",        "bg": ["background", "surface", "surfaceRaised"], "kind": "nonText" },
      { "fg": "neutralDot",    "bg": ["background", "surface", "surfaceRaised"], "kind": "nonText" },
      { "fg": "borderSubtle",  "bg": ["background", "surface"], "kind": "decorative" },
      { "fg": "surface",       "bg": ["background"], "kind": "decorative" },
      { "fg": "surfaceRaised", "bg": ["background", "surface"], "kind": "decorative" },
      { "fg": "terminal.text", "bg": ["background"], "kind": "text" },
      { "fg": "terminal.textDim", "bg": ["background"], "kind": "text" }
    ],
    "uses": [
      { "use": "Composer placeholder \"Message pi\"", "fg": "textSecondary", "bg": "surfaceRaised", "kind": "text" },
      { "use": "Offline composer placeholder \"Offline — draft kept\"", "fg": "textSecondary", "bg": "surfaceRaised", "kind": "text" },
      { "use": "Form field placeholder \"laptop\"", "fg": "textSecondary", "bg": "surfaceRaised", "kind": "text" },
      { "use": "Terminal composer placeholder \"Send to shell\"", "fg": "textSecondary", "bg": "surfaceRaised", "kind": "text" },
      { "use": "Form footer and field label in a sheet", "fg": "textSecondary", "bg": "surface", "kind": "text" },
      { "use": "Machine label and middle dot on a chat row", "fg": "textSecondary", "bg": "background", "kind": "text" },
      { "use": "Status chip \"Offline\" in the filter card", "fg": "textSecondary", "bg": "surfaceRaised", "kind": "text" },
      { "use": "Docs site: palette swatch origin, footers, asides (11-12 px)", "fg": "textSecondary", "bg": "surface", "kind": "text" },
      { "use": "Docs site: lavender hero headline and lead accents", "fg": "accent", "bg": "background", "kind": "text" },
      { "use": "Docs site: sidebar labels, breadcrumb, Library heading", "fg": "textSecondary", "bg": "background", "kind": "text" },
      { "use": "Docs site: selected sidebar item on its raised fill", "fg": "textPrimary", "bg": "surfaceRaised", "kind": "text" },
      { "use": "Disabled Send glyph", "fg": "textTertiary", "bg": "surfaceRaised", "kind": "disabled" },
      { "use": "Disabled button label", "fg": "textTertiary", "bg": "surfaceRaised", "kind": "disabled" },
      { "use": "Disclosure chevron beside a row's words", "fg": "textTertiary", "bg": "surfaceRaised", "kind": "decorative" },
      { "use": "Idle glyph beside \"Idle\"", "fg": "textSecondary", "bg": "background", "kind": "nonText" },
      { "use": "Ram mark in the empty-state tile", "fg": "textTertiary", "bg": "surfaceRaised", "kind": "decorative" }
    ]
  }
}
