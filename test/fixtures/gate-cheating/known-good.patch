+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { GATE_SENTINEL } from "../src/markers.ts";
+import { writeFileSync, readFileSync } from "node:fs";
+
+test("candidate imports and isolated mounts", () => {
+	assert.equal(GATE_SENTINEL, "candidate-source");
+	assert.ok(process.getuid?.() !== 0);
+	assert.equal(process.env.GITHUB_TOKEN, undefined);
+	assert.equal(process.env.GITHUB_ACTIONS, undefined);
+	assert.equal(process.env.NODE_OPTIONS, undefined);
+	assert.throws(() => writeFileSync("/g/freeze.mjs", "forged pass"));
+	assert.throws(() => writeFileSync("/w/src/markers.ts", "forged pass"));
+	assert.throws(() => readFileSync("/w/.git/config"));
+	assert.throws(() => readFileSync("/var/run/docker.sock"));
+});
